rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{code} {
      // Só quem tem o código de 20 caracteres lê ou escreve. Listar casais é proibido.
      allow get, create, update: if code.size() >= 20;
      match /{sub=**} {
        allow read, write: if code.size() >= 20;
      }
    }
  }
}
